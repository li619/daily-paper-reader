{"version": 1, "packs": [{"run_id": "20261022-7dd45f1f8e74", "tag": "hf", "status": "content_pending", "paper_count": 47, "as_of": "2026-10-22", "updated_at": "2026-10-22T10:41:13.590269+00:00", "mode": "starter", "result_count": 47, "content_done": 10, "content_pending": 37, "guide_status": "complete", "export_path": "docs/starter-pack/20261022-7dd45f1f8e74/papers.md", "selected_records": [{"id": "arxiv:2512.05021", "title": "HTR-ConvText: Leveraging Convolution and Textual Information for Handwritten Text Recognition", "score": 9, "route": "20251022-20261021/2512.05021v1", "published": "2025-12-04", "publication_date": "2025-12-04", "publication_date_precision": "day", "publication_date_source": "https://arxiv.org/pdf/2512.05021v1", "publication_date_kind": "arxiv_first_submission", "zh_title": "", "summary": "手写文本识别受限于数据稀缺、书写风格差异大及复杂变音符号。本文提出HTR-ConvText，将残差CNN与带位置编码的MobileViT结合提取笔画级局部特征并保留全局上下文，再用分层ConvText编码器压缩序列长度，并引入文本上下文辅助模块缓解CTC弱点。在IAM、READ2016、LAM和HANDS-VNOnDB上性能与泛化性均优于现有方法，尤其在小样本高多样性场景。", "tags": [], "reading_status": "complete"}, {"id": "arxiv:2608.01646", "title": "Spike-HTR: Spiking Neural Transformer for Handwritten Text Recognition", "score": 9, "route": "20251022-20261021/2608.01646v1", "published": "2026-08-03", "publication_date": "2026-08-03", "publication_date_precision": "day", "publication_date_source": "https://arxiv.org/pdf/2608.01646v1", "publication_date_kind": "arxiv_first_submission", "zh_title": "", "summary": "手写文本识别存在图像背景像素多、宽度序列空白位置多的双重计算不均衡，且静态图像与脉冲网络时序计算不匹配。Spike-HTR用InkCoder将图像转为由粗到细的输入流，并以CTC引导的长度缩减器压缩空白段。仅用T=2脉冲步、目标数据训练、无语言模型解码，在IAM/LAM/READ2016上取得3.5/5.4、2.3/2.5、4.2/3.9的验证/测试CER。", "tags": [], "reading_status": "complete"}, {"id": "arxiv:2602.17387", "title": "DRetHTR: Linear-Time Decoder-Only Retentive Network for Handwritten Text Recognition", "score": 9, "route": "20251022-20261021/2602.17387v1", "published": "2026-02-19", "publication_date": "2026-02-19", "publication_date_precision": "day", "publication_date_source": "https://arxiv.org/pdf/2602.17387v1", "publication_date_kind": "arxiv_first_submission", "zh_title": "", "summary": "手写文本识别常用Transformer，但其KV缓存随输出增长导致解码慢且占内存。DRetHTR改用仅解码器的Retentive Network，以无softmax的retention替代注意力，并注入多尺度序列先验与逐层gamma缩放。推理速度提升1.6-1.9倍、内存降低38-42%且精度不降，在IAM-A、RIMES、Bentham上取得最优字符错误率。", "tags": [], "reading_status": "complete"}, {"id": "arxiv:2609.12705", "title": "ExpertHTR: Unified Handwritten Text Recognition with Multi-Task Learning and Sparse Mixture-of-Experts", "score": 9, "route": "20251022-20261021/2609.12705v1", "published": "2026-09-11", "publication_date": "2026-09-11", "publication_date_precision": "day", "publication_date_source": "https://arxiv.org/pdf/2609.12705v1", "publication_date_kind": "arxiv_first_submission", "zh_title": "", "summary": "手写文本识别资源分散且标注格式不一，难以联合页面级训练。ExpertHTR用统一Page-Region-Line表示构造四个互补任务，并引入共享分支加稀疏路由专家的MoE架构。在七个异构基准上，多源联合训练普遍提升，稀疏专家在六源优于稠密基线，并在IAM段落级达到SOTA。", "tags": [], "reading_status": "complete"}, {"id": "arxiv:2609.35473", "title": "Handwritten Text Recognition Lives in the High-Pixel Variance Subspace", "score": 9, "route": "20251022-20261021/2609.35473v1", "published": "2026-09-28", "publication_date": "2026-09-28", "publication_date_precision": "day", "publication_date_source": "https://arxiv.org/pdf/2609.35473v1", "publication_date_kind": "arxiv_first_submission", "zh_title": "", "summary": "", "tags": [], "reading_status": "pending"}, {"id": "arxiv:2606.24302", "title": "TrOCR for Medieval HTR: A Systematic Ablation Study with Cross-Dataset Validation", "score": 9, "route": "20251022-20261021/2606.24302v1", "published": "2026-06-23", "publication_date": "2026-06-23", "publication_date_precision": "day", "publication_date_source": "https://arxiv.org/pdf/2606.24302v1", "publication_date_kind": "arxiv_first_submission", "zh_title": "", "summary": "中世纪手稿识别需将现代文本预训练的TrOCR适配到差异极大的视觉域，但小样本微调策略缺乏系统评估。本文在13世纪意大利手稿上对对比度归一化、数据增强与层冻结做受控消融，并在READ-16上复现验证。最佳配置CER为8.03%，冻结浅层不显著损害精度，去除CLAHE后CER为7.84%。研究给出可迁移的冻结阈值与错误模式诊断。", "tags": [], "reading_status": "complete"}, {"id": "arxiv:2512.17111", "title": "Digitizing Nepal's Written Heritage: A Comprehensive HTR Pipeline for Old Nepali Manuscripts", "score": 9, "route": "20251022-20261021/2512.17111v2", "published": "2025-12-18", "publication_date": "2025-12-18", "publication_date_precision": "day", "publication_date_source": "https://arxiv.org/pdf/2512.17111v2", "publication_date_kind": "arxiv_first_submission", "zh_title": "", "summary": "针对低资源历史语言古尼泊尔语手写文本难以数字化的问题，本文构建首个端到端手写文本识别流水线。采用行级转写，系统探索编码器-解码器架构与数据中心技术，并评估解码策略、分析词元级混淆。最佳模型字符错误率4.9%，公开训练代码与评估脚本，推动低资源历史文字识别研究。", "tags": [], "reading_status": "complete"}, {"id": "arxiv:2605.05900", "title": "Understanding Cross-Language Transfer Improvements in Low-Resource HTR: The Role of Sequence Modeling", "score": 9, "route": "20251022-20261021/2605.05900v1", "published": "2026-05-07", "publication_date": "2026-05-07", "publication_date_precision": "day", "publication_date_source": "https://arxiv.org/pdf/2605.05900v1", "publication_date_kind": "arxiv_first_submission", "zh_title": "", "summary": "低资源阿拉伯文字系手写文本识别中，跨语言联合训练常带来提升，但尚不清楚其来源是共享视觉表征还是序列级依赖。本文在相同单语与多语训练条件下，对比仅CNN配CTC与CRNN两种架构。结果显示CRNN在多语训练下提升更明显，尤其在数据最受限时；仅共享CNN视觉表征不足以解释迁移。", "tags": [], "reading_status": "complete"}, {"id": "arxiv:2605.02089", "title": "Cross-Lingual Learning within Arabic Script for Low-Resource HTR", "score": 9, "route": "20251022-20261021/2605.02089v2", "published": "2026-05-03", "publication_date": "2026-05-03", "publication_date_precision": "day", "publication_date_source": "https://arxiv.org/pdf/2605.02089v2", "publication_date_kind": "arxiv_first_submission", "zh_title": "", "summary": "阿拉伯字母语言的手写文本识别在标注数据稀缺时性能骤降。本文在行级低资源设定下，将阿拉伯语、乌尔都语和波斯语数据联合训练CRNN与HTR-VT模型。两种架构均受益于跨语言训练，CRNN在极少目标语数据时更稳健。波斯语CER达9.99，乌尔都语CER由17.20降至14.45。", "tags": [], "reading_status": "complete"}, {"id": "arxiv:2606.19139", "title": "Urdu Katib Handwritten Dataset: A Historical Document Dataset for Offline Urdu Handwritten Text Recognition with CRNN-Based Baseline Evaluation", "score": 9, "route": "20251022-20261021/2606.19139v1", "published": "2026-06-17", "publication_date": "2026-06-17", "publication_date_precision": "day", "publication_date_source": "https://arxiv.org/pdf/2606.19139v1", "publication_date_kind": "arxiv_first_submission", "zh_title": "", "summary": "乌尔都文手写识别因草书复杂与基准数据稀缺而研究滞后。本文构建首个源自历史Katib书写的离线乌尔都文手写文本行数据集UKHD，涵盖Nastalique风格多种平笔变化。采用CRNN混合模型评估，CNN-BGRU-CTC取得更低字符与词错误率。该工作为乌尔都文手写文献保护提供数据与基线。", "tags": [], "reading_status": "complete"}, {"id": "arxiv:2609.20064", "title": "A Free Lunch? Adapting PP-OCRv6 for Historical Text Recognition", "score": 9, "route": "20251022-20261021/2609.20064v1", "published": "2026-09-17", "publication_date": "2026-09-17", "publication_date_precision": "day", "publication_date_source": "https://arxiv.org/pdf/2609.20064v1", "publication_date_kind": "arxiv_first_submission", "zh_title": "", "summary": "历史自动文本识别仍依赖紧凑CRNN，轻量无循环识别器尚未在历史手写材料上系统评估。作者将PP-OCRv6适配到历史行识别，比较多语言拉丁与阿拉伯文字料上的预训练、域内训练、语料微调与少样本适配。结果显示从零训练时PP-OCRv6并不稳定优于基线，但异构预训练带来明显更好的泛化，微调后甚至超过面向历史拉丁文HTR的大型视觉语言模型。", "tags": [], "reading_status": "complete"}, {"id": "work:b7924857f32dae7965ddf42a", "title": "On the Generalization of Handwritten Text Recognition Models", "score": 8, "route": "conference/cvpr-2025/cvpr-2025-garrido-munoz-on-the-generalization-of-handwritten-text-recognition-models-cvpr-2025-paper-on-the-generalization-of-handwritten-text-recognition-models", "published": "2025", "publication_date": "2025", "publication_date_precision": "year", "publication_date_source": "conference year only; exact release date unverified", "publication_date_kind": "unknown", "zh_title": "", "summary": "", "tags": [], "reading_status": "pending"}, {"id": "arxiv:2609.37195", "title": "Exploring In-Context Learning for Handwritten Text Recognition", "score": 8, "route": "20251022-20261021/2609.37195v1", "published": "2026-09-29", "publication_date": "2026-09-29", "publication_date_precision": "day", "publication_dat